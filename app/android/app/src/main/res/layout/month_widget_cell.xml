<?xml version="1.0" encoding="utf-8"?>
<!--
  Event rows are 3 fixed, statically-declared slots (+ one overflow line)
  toggled via setViewVisibility from MonthWidgetProvider, not built with
  RemoteViews#addView() per event. A day cell is already 2 levels deep in
  dynamically-composed RemoteViews (month_widget -> month_widget_row ->
  month_widget_cell); a 3rd level (one more RemoteViews object per event,
  added into this cell) reliably lost width — children measured near-0dp
  regardless of match_parent/weight. Static children of this same file
  size correctly (see day_number), so the event rows live here instead.

  Each row's own background is set dynamically (solid for all-day events,
  tinted for timed — mirrors the two event pill styles in MonthView.svelte),
  so a little padding is baked in here to give that fill room to breathe.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="2dp"
    android:paddingStart="1dp"
    android:paddingEnd="1dp">

    <FrameLayout
        android:layout_width="18dp"
        android:layout_height="18dp">

        <!-- Today's accent-colored circle — a themed bitmap set from
             MonthWidgetProvider, cleared (0) on non-today cells. -->
        <ImageView
            android:id="@+id/day_number_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/day_number"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="10sp"
            android:textColor="@color/widget_text" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:orientation="vertical">

        <!-- Each row is a *fixed* height rather than wrap_content: a
             wrap_content FrameLayout with a match_parent child (event_bg_N,
             used by all-day/spanning events) doesn't reliably wrap to the
             other children's content size — it can measure event_bg_N
             against whatever space is available further up the tree
             instead, making an all-day/spanning row balloon taller than a
             plain timed row right next to it. Fixing the height also keeps
             every row in a given slot the same height across the whole
             week regardless of what kind of event lands in it that day. -->
        <FrameLayout
            android:id="@+id/event_row_1"
            android:layout_width="match_parent"
            android:layout_height="13dp"
            android:layout_marginBottom="1dp"
            android:paddingStart="2dp" android:paddingEnd="2dp">
            <!-- Multi-day (spanning) events only: a rounded-corner bitmap
                 standing in for the row's background, tinted + shaped from
                 MonthWidgetProvider.pillBitmap so consecutive days read as
                 one continuous bar (see buildCell). Gone for single-day
                 events, which keep the plain setBackgroundColor fill. -->
            <ImageView android:id="@+id/event_bg_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:visibility="gone" />
            <ImageView android:id="@+id/event_accent_1" android:layout_width="2dp" android:layout_height="8dp" android:layout_gravity="start|center_vertical" android:src="@drawable/dot_shape" />
            <TextView android:id="@+id/event_title_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="3dp" android:textSize="7sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_text" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/event_row_2"
            android:layout_width="match_parent"
            android:layout_height="13dp"
            android:layout_marginBottom="1dp"
            android:paddingStart="2dp" android:paddingEnd="2dp">
            <ImageView android:id="@+id/event_bg_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:visibility="gone" />
            <ImageView android:id="@+id/event_accent_2" android:layout_width="2dp" android:layout_height="8dp" android:layout_gravity="start|center_vertical" android:src="@drawable/dot_shape" />
            <TextView android:id="@+id/event_title_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="3dp" android:textSize="7sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_text" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/event_row_3"
            android:layout_width="match_parent"
            android:layout_height="13dp"
            android:layout_marginBottom="1dp"
            android:paddingStart="2dp" android:paddingEnd="2dp">
            <ImageView android:id="@+id/event_bg_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:visibility="gone" />
            <ImageView android:id="@+id/event_accent_3" android:layout_width="2dp" android:layout_height="8dp" android:layout_gravity="start|center_vertical" android:src="@drawable/dot_shape" />
            <TextView android:id="@+id/event_title_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="3dp" android:textSize="7sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_text" />
        </FrameLayout>

        <TextView
            android:id="@+id/overflow_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="7sp"
            android:textStyle="bold"
            android:paddingStart="2dp"
            android:textColor="@color/widget_text_muted" />

    </LinearLayout>

</LinearLayout>
