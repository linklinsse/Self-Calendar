<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      usesCleartextTraffic stays blanket-enabled: this is a self-hostable
      app and API_BASE_URL commonly points at a plain-HTTP LAN address
      chosen at deploy time (see docker-compose.yml / root README). Android's
      networkSecurityConfig <domain> matching only supports exact
      hostnames/IPs, not CIDR ranges, so it can't express "private ranges
      only" without knowing each deployer's server address in advance —
      scoping it here would silently break the app's primary deployment
      story rather than fix anything. allowBackup=false below (plus
      TokenStore's EncryptedSharedPreferences) covers the token-exposure
      risk that mattered most from this finding.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

		<!-- Deep links. `day` is used by the home-screen widget to jump to a
		     date; `event` is what we write into an exported event's description
		     so the user can get back from their system calendar to the event
		     here. Both are handled in src/routes/+layout.svelte. -->
		<intent-filter>
    			<action android:name="android.intent.action.VIEW" />
    			<category android:name="android.intent.category.DEFAULT" />
    			<category android:name="android.intent.category.BROWSABLE" />
    			<data android:scheme="selfcalendar" android:host="day" />
    			<data android:scheme="selfcalendar" android:host="event" />
		</intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <receiver android:name=".widget.MonthWidgetProvider" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/month_widget_info" />
        </receiver>
    </application>

    <!--
      Package visibility (Android 11+). Without this, resolveActivity() for
      the calendar insert intent always returns null even when a calendar app
      is installed, because the app cannot see packages it hasn't declared an
      interest in — CalendarBridgePlugin would then report NO_CALENDAR_APP on
      every modern device. Declaring the intent we actually fire is the
      narrow form of this; <queries> with no filter would request visibility
      of everything installed, which is not needed here.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>

    <!-- Permissions -->

    <!--
      No READ_CALENDAR/WRITE_CALENDAR here on purpose: exporting an event
      goes through the system calendar's own editor via ACTION_INSERT, which
      needs no permission and keeps the user in control of what is written
      and to which calendar. See CalendarBridgePlugin's class docstring.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
