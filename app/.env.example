# Copy this file to .env.local (gitignored — never committed) and fill in
# your own values. Vite requires the VITE_ prefix on every variable; see
# src/lib/config.js for the full list and defaults.
#
#   cp .env.example .env.local
#
# Used for any build-time build: `npm run build`, `make android`, `make ios`.
# Not needed for Docker — there these are set as plain (no VITE_ prefix)
# environment variables on the container instead, injected at container
# start (see docker-entrypoint.sh / the root README's Docker section).

# Your own API's origin (no trailing slash). Defaults to the page's own
# origin if unset — fine for Docker (same host) or local dev against
# `npm run dev` + `cd api && make dev` on the same machine, but the native
# Android/iOS builds have no "page origin" to fall back to, so this MUST
# be set before building those.
VITE_API_BASE_URL=https://api.yourdomain.com
