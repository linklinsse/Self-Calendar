# ──────────────────────────────────────────────
# Self Calendar — docker-compose environment template
#
# Copy this file to conf/.env before running `docker compose up` (conf/.env
# itself is gitignored and never committed — if it ever goes missing,
# re-copy it from here). See docker-compose.yml and the root README's
# "Quick start (Docker / prod-style)" section.
#
# IMPORTANT: DB_URL must point inside the ./db volume mount (see
# docker-compose.yml: "./db:/work/db"), i.e. "./db/<name>.db" relative to
# the api container's WORKDIR (/work). If conf/.env is missing entirely,
# the api silently falls back to its built-in default DB_URL, which points
# *outside* that volume and inside the container's own throwaway
# filesystem — every container recreation then looks like the database
# "reset", when really it's just never being persisted at all.
# ──────────────────────────────────────────────

# ── General ───────────────────────────────────
# True lets you create your first account via the app's own Register
# screen. Set to False once you (and anyone else who needs one) have an
# account, to close public registration.
USER_CREATION=True

# ── Authentication ─────────────────────────────
# Generate a real value before any real/shared deployment:
#   openssl rand -hex 32
SECRET_KEY=change-me-use-openssl-rand-hex-32

# JWT signing algorithm
ALGORITHM=HS256

# Token lifetime in minutes (default: 24 h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ───────────────────────────────────
# Must stay inside the ./db volume mount — see the warning above.
DB_URL=sqlite:///./db/prod.db

# ── CORS ────────────────────────────────────
# Must match whatever host port `web` is actually served on
# (docker-compose.yml's `web.ports`), since the api and web are on
# different ports and the browser's requests to the api are cross-origin.
CORS_ORIGINS=["http://localhost:8686"]

# ── Rate limiting ────────────────────────────
RATE_LIMIT_MAX_FAILURES=5
RATE_LIMIT_TIMEOUT_SECONDS=180
