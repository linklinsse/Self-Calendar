meta {
  name: create
  type: http
  seq: 1
}

post {
  url: http://{{server_ip}}:{{server_port}}/category
  body: json
  auth: inherit
}

body:json {
  {
    "calendar_id": "{{calendar_id}}",
    "title": "My Category",
    "color": "#FF5733"
  }
}

vars:post-response {
  category_id: res.body.id
}

settings {
  encodeUrl: true
  timeout: 0
}
