meta {
  name: edit
  type: http
  seq: 4
}

patch {
  url: http://{{server_ip}}:{{server_port}}/calendar/{{calendar_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "title": "new title here",
    "description": "new description here",
    "color": "#00FF00"
  }
}

vars:pre-request {
  calendar_id: 1f8cfaac-38d0-4e62-810e-de776d77cf6f
}

settings {
  encodeUrl: true
  timeout: 0
}
