meta {
  name: edit with recurence
  type: http
  seq: 8
}

patch {
  url: http://{{server_ip}}:{{server_port}}/event/{{event_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Updated title",
    "description": "Updated description",
    "date_start": 1700000000,
    "date_end": 1700007200,
    "category_id": null,
    "address": null,
    "reminder": null,
    "recurrence_id": null,
    "obj_recurence": {
      "type": "W",
      "interval": 1,
      "days": "1111100",
      "endType": "C",
      "count": 25,
      "until": null
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
