meta {
  name: create recurrence weekly
  type: http
  seq: 3
}

post {
  url: http://{{server_ip}}:{{server_port}}/event
  body: json
  auth: inherit
}

body:json {
  {
    "calendar_id": "{{calendar_id}}",
    "title": "My Event",
    "description": "My description",
    "date_start": 1700000000,
    "date_end": 1700003600,
    "category_id": null,
    "address": null,
    "reminder": null,
    "obj_recurence": {
      "type": "W",
      "interval": 1,
      "days": "1111100",
      "endType": "C",
      "count": 25,
      "until": null
    }
  }
}

vars:post-response {
  event_id: res.body.id
}

settings {
  encodeUrl: true
  timeout: 0
}
