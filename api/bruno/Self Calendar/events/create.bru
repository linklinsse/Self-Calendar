meta {
  name: create
  type: http
  seq: 1
}

post {
  url: http://{{server_ip}}:{{server_port}}/event
  body: json
  auth: inherit
}

body:json {
  {
    "calendar_id": "{{calendar_id}}",
    "title": "Mon Titre",
    "description": "Ma description",
    "date_start": 10,
    "date_end": 20,
    "category_id": null,
    "adresse": null,
    "reminder": null,
    "recurrence_id": null
  }
}

vars:post-response {
  event_id: res.body.id
}

settings {
  encodeUrl: true
  timeout: 0
}
