meta {
  name: get range
  type: http
  seq: 6
}

get {
  url: http://{{server_ip}}:{{server_port}}/event/range?calendar_ids={{calendar_id}}
  body: none
  auth: inherit
}

params:query {
  calendar_ids: {{calendar_id}}
  ~category_ids: 94e94993-3ee2-4ba9-b7e1-b9659a40590d
  ~to_date: 1800000000
  ~from_date: 1800600000
}

settings {
  encodeUrl: true
  timeout: 0
}
