meta {
  name: login
  type: http
  seq: 1
}

post {
  url: http://{{server_ip}}:{{server_port}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "test",
    "password": "test"
  }
}

script:post-response {
  const token = res.body
  bru.setVar('BearerToken',token)
}

settings {
  encodeUrl: true
  timeout: 0
}
