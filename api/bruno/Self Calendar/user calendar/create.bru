meta {
  name: create
  type: http
  seq: 2
}

post {
  url: http://{{server_ip}}:{{server_port}}/user_calendar
  body: json
  auth: inherit
}

body:json {
  {
    "username": "target_username",
    "calendar_id": "{{calendar_id}}",
    "right": "R"
  }
}

vars:post-response {
  membership_id: res.body.id
}

settings {
  encodeUrl: true
  timeout: 0
}
