# ──────────────────────────────────────────────
# Self Calendar API – Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ── General ───────────────────────────────────

USER_CREATION=False

# ── Authentication ─────────────────────────────
# Secret key used to sign JWT tokens.
# Generate a strong value with:  openssl rand -hex 32
SECRET_KEY=change-me-use-openssl-rand-hex-32

# JWT signing algorithm
ALGORITHM=HS256

# Token lifetime in minutes (default: 24 h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ───────────────────────────────────
# SQLite (default – development only)
# NOTE: this template is for running the API *directly*, outside Docker.
# For docker-compose, use the template at the repository root instead — it
# sets DB_URL to ./db/prod.db, which is the mounted volume. This dev default
# resolves inside the container's own layer, where the database is destroyed
# on every `docker compose down`. The API refuses to start on it in a
# container rather than letting that happen silently.
DB_URL=sqlite:///./dev.db

# PostgreSQL example:
# DB_URL=postgresql+psycopg2://user:password@localhost:5432/selfcalendar

# ── CORS ────────────────────────────────────
# Empty by default — no cross-origin requests are allowed unless explicitly
# configured. Add origins in .env as a comma-separated list:
#   CORS_ORIGINS=h'["http://localhost:5173,https://app.example.com"]'
# A warning is printed at startup for every origin that is allowed.
# CORS_ORIGINS='["http://localhost:5173"]'

# ── Rate limiting ────────────────────────────
# Number of consecutive failed requests from an IP before it is blocked.
RATE_LIMIT_MAX_FAILURES=5
# How long (seconds) a blocked IP must wait before trying again.
RATE_LIMIT_TIMEOUT_SECONDS=180