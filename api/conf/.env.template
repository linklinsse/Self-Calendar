# ──────────────────────────────────────────────
# Self Calendar API – Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ── General ───────────────────────────────────

USER_CREATION=Frue

# ── Authentication ─────────────────────────────
# Secret key used to sign JWT tokens.
# Generate a strong value with:  openssl rand -hex 32
SECRET_KEY=change-me-use-openssl-rand-hex-32

# JWT signing algorithm
ALGORITHM=HS256

# Token lifetime in minutes (default: 24 h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ───────────────────────────────────
# SQLite (default – development only)
DB_URL=sqlite:///./dev.db

# PostgreSQL example:
# DB_URL=postgresql+psycopg2://user:password@localhost:5432/selfcalendar
