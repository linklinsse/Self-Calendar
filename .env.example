# docker-compose variables. Copy to .env (gitignored, same directory as
# docker-compose.yml — Docker Compose loads it automatically, no --env-file
# flag needed) and fill in your own values:
#
#   cp .env.example .env
#
# This is separate from conf/.env (the api's own runtime settings, mounted
# *into* the api container — SECRET_KEY, CORS_ORIGINS, DB_URL, etc.; see
# conf/.env.template) and from app/.env.local (build-time config for a
# native Android/iOS build). This file only controls docker-compose.yml
# itself.

# ── Ports (host side only — see docker-compose.yml's comments) ──────────
WEB_PORT=8686
API_PORT=8787

# ── Web app config, injected into the browser at container start ────────
# Your API's public URL, as reachable from the *browser* (not from inside
# the Docker network) — e.g. https://api.yourdomain.com. Left unset, this
# defaults to http://localhost:8787, which only works for local/LAN access.
#
# Write the actual port number here, not a reference to API_PORT above
# (e.g. NOT "https://yourdomain.com:${API_PORT}") — Docker Compose doesn't
# reliably expand ${...} references written inside another variable's own
# value, and depending on your Compose version this can silently produce a
# broken URL with a stray "}" in it instead of erroring.
# API_BASE_URL=https://calendar.yourdomain.com:8787

APP_NAME=Self Calendar

# Optional — leave unset to use the app's built-in defaults.
# THEME=blushNoir
# DEFAULT_VIEW=month
# FIRST_DAY_OF_WEEK=1
# LOCALE=en-US
# HOUR_FORMAT=24

# ── Reminder ──────────────────────────────────────────────────────────
# If you change WEB_PORT, also update CORS_ORIGINS in conf/.env to match
# (e.g. CORS_ORIGINS=["http://localhost:8686"]) — that file is a separate
# mechanism (read by the api container itself) that docker-compose
# variables can't reach into.
